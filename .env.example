# ── Credenciais da API Betel ─────────────────────────────────────────────────
BETEL_ACCESS_TOKEN=seu_access_token_aqui
BETEL_SECRET_ACCESS_TOKEN=seu_secret_access_token_aqui

# ── URLs dos webhooks (n8n) ──────────────────────────────────────────────────
WEBHOOK_ORCAMENTOS=https://tecnologiasup.app.n8n.cloud/webhook/...
WEBHOOK_VENDAS=https://tecnologiasup.app.n8n.cloud/webhook/...
WEBHOOK_ORDENS_SERVICOS=https://tecnologiasup.app.n8n.cloud/webhook/...

# ── Redis — Railway injeta automaticamente ao adicionar o plugin Redis
#            Render injeta automaticamente via render.yaml (fromService)
#            Para testar localmente: redis://localhost:6379
REDIS_URL=redis://localhost:6379

# ── IDs iniciais (apenas para o primeiro deploy — remova após subir) ─────────
# Valores atuais do state.json local:
ORCAMENTOS_LAST_ID=365431561
VENDAS_LAST_ID=332604865
ORDENS_SERVICOS_LAST_ID=347527339

# ── Intervalo de polling em segundos (padrão: 60) ────────────────────────────
# POLL_INTERVAL=60

# ── Parâmetros opcionais (já têm valores padrão no código) ───────────────────
# BETEL_API_URL=https://api.beteltecnologia.com
# CENTRO_CUSTO_ORCAMENTOS=240910
# SITUACAO_VENDAS=5943149
# CENTRO_CUSTO_OS=240830
